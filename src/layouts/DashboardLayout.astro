---
import '../styles/global.css';
---
<!doctype html>
<html lang="id" data-theme="dark">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Dashboard — License Manager</title><script is:inline>const t=localStorage.getItem('lm-theme'); document.documentElement.dataset.theme=t || 'dark';</script></head>
  <body>
    <div class="dashboard-shell">
      <aside class="sidebar" id="sidebar">
        <a class="brand" href="/dashboard"><span class="brand-mark"><iconify-icon icon="lucide:key-round" width="20" ></iconify-icon></span><span>license<span class="brand-accent">.manager</span></span></a>
        <nav class="sidebar-nav" aria-label="Dashboard navigation">
          <div class="nav-label">Workspace</div>
          <a class="side-link" data-path="/dashboard" href="/dashboard"><iconify-icon icon="lucide:layout-dashboard" width="17" ></iconify-icon>Overview</a>
          <a class="side-link" data-path="/dashboard/mappings" href="/dashboard/mappings"><iconify-icon icon="lucide:blocks" width="17" ></iconify-icon>Product mappings</a>
          <a class="side-link" data-path="/dashboard/lynk-accounts" href="/dashboard/lynk-accounts"><iconify-icon icon="lucide:store" width="17" ></iconify-icon>Lynk accounts</a>
          <a class="side-link" data-path="/dashboard/audit-logs" href="/dashboard/audit-logs"><iconify-icon icon="lucide:scroll-text" width="17" ></iconify-icon>Audit logs</a>
        </nav>
        <div class="sidebar-bottom">
          <button class="side-link" type="button" data-theme-toggle><iconify-icon icon="lucide:moon" width="17" ></iconify-icon><span>Toggle theme</span></button>
          <div class="profile"><span class="avatar" id="profile-avatar">A</span><div><strong id="profile-name">Admin</strong><small>Administrator</small></div><button class="row-action" id="logout-button" title="Logout" type="button"><iconify-icon icon="lucide:log-out" width="16" ></iconify-icon></button></div>
        </div>
      </aside>
      <main class="dashboard-main"><div class="dashboard-topbar"><div><button class="icon-button mobile-menu" id="menu-button" type="button" aria-label="Open menu"><iconify-icon icon="lucide:menu" width="19" ></iconify-icon></button><h1 id="page-title" style="display:inline-block; margin-left:10px">Overview</h1><p id="page-subtitle">Monitor your license ecosystem.</p></div><div class="topbar-actions"><button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme"><iconify-icon icon="lucide:sun" width="18" class="theme-light-icon" ></iconify-icon><iconify-icon icon="lucide:moon" width="18" class="theme-dark-icon" ></iconify-icon></button><a class="button button-ghost button-small" href="/check"><iconify-icon icon="lucide:external-link" width="15" ></iconify-icon>Public check</a></div></div><div id="dashboard-root"></div></main>
    </div>
    <div class="toast" id="toast"></div>
    <div class="modal-backdrop" id="modal-backdrop"><div class="modal" id="modal"></div></div>
    <script>
      // @ts-nocheck
      import '../lib/icons';
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => button.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; localStorage.setItem('lm-theme', next); }));
      document.querySelector('#menu-button')?.addEventListener('click', () => document.querySelector('#sidebar').classList.toggle('open'));
      const currentPath = location.pathname.replace(/\/+$/, '') || '/';
      document.querySelectorAll('.side-link').forEach((link) => { if (link.dataset.path === currentPath) link.classList.add('active'); });
    </script>
    <script>import('../lib/dashboard');</script>
  </body>
</html>
